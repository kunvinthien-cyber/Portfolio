# Telegram bot configuration
# Create frontend/.env and replace these values with your real Telegram data.
VITE_TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ
VITE_TELEGRAM_CHAT_ID=987654321

# Keep this as /telegram for local Vite dev/preview.
# For a deployed static site, set this to your own backend/proxy URL.
VITE_TELEGRAM_API_BASE_URL=/telegram
